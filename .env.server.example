# Server-only template for the future VOH API. This file is not consumed by Vite.
# Store real values in the backend deployment's secret manager, never in browser code.
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_SSL_MODE=disable
CATALOG_ALLOWED_ORIGINS=http://localhost:5173
# Authentication is intentionally not implemented. Admin API writes are denied until a trusted authorizer is installed.