# Server-only API/database settings. This template is not loaded automatically.
# Set these in the API process environment or a server-side secret manager.
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_SSL_MODE=require
CATALOG_ALLOWED_ORIGINS=http://localhost:5173

# Optional RS256 identity-provider token verification. Leave all three values
# blank to keep every /admin endpoint disabled (fail-closed).
ADMIN_JWT_ISSUER=
ADMIN_JWT_AUDIENCE=
ADMIN_JWT_PUBLIC_KEY=
# The trusted issuer must provide catalog:read and catalog:write scopes.
# Billing also uses the verified subject as the account key. Checkout requires
# a verified email claim. The browser API accepts a verified JWT in an
# HttpOnly cookie; this repository does not issue the cookie or login session.
ADMIN_JWT_COOKIE_NAME=voh_admin_session

# Hosted Paystack checkout is disabled until the server receives a secret key
# and PUBLIC_APP_URL. Do not put the secret in a VITE_ variable.
PAYSTACK_SECRET_KEY=
PUBLIC_APP_URL=

# Paid plans stay unavailable until amount, currency, and interval are all set.
# Amounts are integer minor units. No prices are assumed by this project.
PLAN_MEDIUM_PRICE_MINOR=
PLAN_MEDIUM_CURRENCY=
PLAN_MEDIUM_BILLING_INTERVAL=
PLAN_MEDIUM_FEATURES=
PLAN_MEDIUM_VIDEO_QUALITIES=
PLAN_MEDIUM_MAX_CONCURRENT_STREAMS=
PLAN_MEDIUM_MAX_WATCHLIST_ENTRIES=
PLAN_PRO_PRICE_MINOR=
PLAN_PRO_CURRENCY=
PLAN_PRO_BILLING_INTERVAL=
PLAN_PRO_FEATURES=
PLAN_PRO_VIDEO_QUALITIES=
PLAN_PRO_MAX_CONCURRENT_STREAMS=
PLAN_PRO_MAX_WATCHLIST_ENTRIES=

# Empty quality lists and feature lists grant no additional product features.
PLAN_FREE_FEATURES=
PLAN_FREE_VIDEO_QUALITIES=
PLAN_FREE_MAX_CONCURRENT_STREAMS=
PLAN_FREE_MAX_WATCHLIST_ENTRIES=
AD_SUPPORTED_PLAN_CODES=FREE

# Rentals are disabled unless all three values are configured.
RENTAL_PRICE_MINOR=
RENTAL_CURRENCY=
RENTAL_ACCESS_HOURS=