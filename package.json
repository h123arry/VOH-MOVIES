{
  "name": "voh-movies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:dev": "tsx watch server/src/index.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node server/dist/server/src/index.js",
    "db:migrate": "tsx server/src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@tailwindcss/vite": "^4.1.11",
    "fastify": "^5.3.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.1.11",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
